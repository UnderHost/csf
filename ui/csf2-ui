#!/usr/bin/perl
###############################################################################
# CSF 2.0 - Core Shield Firewall
# csf2-ui - standalone web UI service for servers without WHM (CloudPanel,
# plain Linux). It serves the same firewall UI as the WHM plugin, behind its
# own login (password + TOTP), on 127.0.0.1 only. Publish it through a reverse
# proxy with TLS (CloudPanel: a reverse-proxy site), or reach it over an SSH
# tunnel. It never listens on a public address unless UI_BIND says so.
#
# Security model (see CSF2::UIAuth):
#   - every page except /login needs a valid session cookie
#   - POST requests must carry the session's CSRF token (injected into forms)
#   - GET requests may not carry mutating actions
#   - cookie: HttpOnly, SameSite=Strict, Secure when served over HTTPS
#   - per-IP login throttling, UI_ALLOW CIDR allowlist, failures logged to
#     /var/log/csf2-ui.log (LFD watches it and blocks brute force)
#
# Copyright (C) 2026 CSF - Core Shield Firewall (GNU GPL v3).
###############################################################################

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib", '/usr/local/csf/lib';
use IO::Socket::INET;
use IO::Select;
use POSIX qw(WNOHANG strftime);
use CSF2::Config;
use CSF2::IP qw(ip_in_any checkip normalize);
use CSF2::UIAuth;

my $etc = $ENV{CSF2_ETC} || '/etc/csf';
my $var = $ENV{CSF2_VAR} || '/var/lib/csf';
my %cfg = CSF2::Config->loadconfig(file => "$etc/csf.conf")->config;

my $BIND  = $cfg{UI_BIND}  || '127.0.0.1';
my $PORT  = ($cfg{UI_PORT} && $cfg{UI_PORT} =~ /^\d+$/) ? $cfg{UI_PORT} : 6789;
# only real IPs/CIDRs count: a leftover legacy value such as "1" must not lock
# everyone out (or, worse, be misread as a rule)
my @ALLOW = grep { checkip($_) || CSF2::IP::is_cidr($_) }
            grep { length } map { s/^\s+|\s+$//gr } split /,/, ($cfg{UI_ALLOW} // '');
my $TRUST_PROXY = (defined $cfg{UI_TRUST_PROXY} && $cfg{UI_TRUST_PROXY} eq '0') ? 0 : 1;
# Any local process can connect to 127.0.0.1 and send X-Real-IP, so the visitor
# address from a proxy is only believed when the proxy also sends the secret
# key from $etc/ui.proxykey (root-only; the installer adds it to nginx sites
# that proxy to this UI). Without the key every request counts as 127.0.0.1.
my $PROXY_KEY = do { my $k = ''; if (open my $kf, '<', "$etc/ui.proxykey") { $k = <$kf> // ''; close $kf } $k =~ s/\s+//g; $k };
my $CGI   = $ENV{CSF2_UI_CGI} || '/usr/local/csf/ui/firewall.cgi';
my $LOGO  = $ENV{CSF2_UI_LOGO} || '/usr/local/csf/ui/logo.png';
my $LOG   = $ENV{CSF2_UI_LOG} || '/var/log/csf2-ui.log';
my $MAX_BODY = 2 * 1024 * 1024;

my $auth = CSF2::UIAuth->new(etc => $etc, var => $var);

my $srv = IO::Socket::INET->new(
    LocalAddr => $BIND, LocalPort => $PORT, Proto => 'tcp',
    Listen => 64, ReuseAddr => 1,
) or die "csf2-ui: cannot listen on $BIND:$PORT: $!\n";
ulog("started, listening on $BIND:$PORT");
print "csf2-ui: listening on $BIND:$PORT\n";

$SIG{CHLD} = sub { 1 while waitpid(-1, WNOHANG) > 0 };
$SIG{PIPE} = 'IGNORE';
$SIG{TERM} = sub { ulog('stopped'); exit 0 };

my $last_purge = 0;
while (1) {
    my $c = $srv->accept or next;
    if (time - $last_purge > 600) { $auth->purge_sessions; $last_purge = time }
    my $pid = fork();
    if (!defined $pid) { close $c; next }
    if ($pid) { close $c; next }
    close $srv;
    $SIG{CHLD} = 'DEFAULT';      # let run_cgi wait for its own child
    local $SIG{ALRM} = sub { exit 0 };
    alarm 180;
    eval { handle($c); 1 } or ulog("error: $@");
    close $c;
    exit 0;
}

###############################################################################
sub ulog {
    my ($m) = @_;
    if (open my $fh, '>>', $LOG) {
        print {$fh} strftime('%Y-%m-%d %H:%M:%S', localtime) . " csf2-ui: $m\n";
        close $fh;
    }
}

sub handle {
    my ($c) = @_;
    binmode $c;
    my $peer = $c->peerhost // '';

    # --- request line + headers ---
    my $line = <$c>; return unless defined $line;
    $line =~ s/\r?\n$//;
    my ($method, $target) = $line =~ m{^(GET|POST|HEAD) (\S+) HTTP/1\.[01]$} or return respond($c, 400, 'text/plain', "bad request\n");
    my %h; my $hbytes = 0;
    while (my $l = <$c>) {
        $hbytes += length $l;
        return respond($c, 431, 'text/plain', "headers too large\n") if $hbytes > 65536;
        $l =~ s/\r?\n$//;
        last if $l eq '';
        my ($k, $v) = split /:\s*/, $l, 2;
        $h{lc $k} = $v if defined $v;
    }
    my ($path, $query) = split /\?/, $target, 2;
    $query //= '';

    # --- client address (behind a local reverse proxy, trust its header) ---
    my $ip = $peer;
    my $local = ($peer eq '127.0.0.1' || $peer eq '::1');
    if ($local && $TRUST_PROXY && length($PROXY_KEY) >= 32
        && CSF2::UIAuth::ct_eq($PROXY_KEY, $h{'x-csf-proxy-key'} // '')) {
        my $fwd = $h{'x-real-ip'} // ((split /\s*,\s*/, ($h{'x-forwarded-for'} // ''))[-1]);
        $ip = normalize($fwd) if defined $fwd && checkip($fwd);
    }
    my $https = (($h{'x-forwarded-proto'} // '') eq 'https') ? 1 : 0;

    if (@ALLOW && !($ip eq '127.0.0.1' || $ip eq '::1') && !ip_in_any($ip, \@ALLOW)) {
        ulog("denied $ip (not in UI_ALLOW)");
        return respond($c, 403, 'text/plain', "access denied\n");
    }

    # --- body ---
    my $body = '';
    if ($method eq 'POST') {
        my $len = $h{'content-length'} // 0;
        return respond($c, 411, 'text/plain', "length required\n") unless $len =~ /^\d+$/;
        return respond($c, 413, 'text/plain', "too large\n") if $len > $MAX_BODY;
        my $got = 0;
        while ($got < $len) { my $r = read($c, $body, $len - $got, $got); last unless $r; $got += $r }
    }
    my %form = parse_qs($method eq 'POST' ? $body : $query);

    my %cookie = map { my ($k, $v) = split /=/, $_, 2; ($k // '') => ($v // '') } split /;\s*/, ($h{cookie} // '');
    my $token = $cookie{csf2ui};
    my $sess  = $auth->check_session($token);

    # --- static: logo ---
    if ($path eq '/assets/logo.png') {
        open my $fh, '<:raw', $LOGO or return respond($c, 404, 'text/plain', "not found\n");
        local $/; my $png = <$fh>; close $fh;
        return respond($c, 200, 'image/png', $png, { 'Cache-Control' => 'max-age=86400' });
    }

    # --- same-origin check for anything state-changing ---
    my $same_origin = same_origin(\%h);

    # --- login / logout ---
    if ($path eq '/login') {
        if ($method eq 'POST') {
            return respond($c, 403, 'text/plain', "cross-site request refused\n") unless $same_origin;
            if ($auth->is_locked($ip)) {
                ulog("login locked for $ip (too many failures)");
                return respond($c, 429, 'text/html; charset=utf-8', login_page('Too many failed attempts. Try again in 15 minutes.'));
            }
            my ($ok) = $auth->login($form{user}, $form{pass}, $form{code}, $ip);
            my $u = defined $form{user} ? substr($form{user}, 0, 32) : '';
            $u =~ s/[^A-Za-z0-9_.-]/?/g;
            unless ($ok) {
                ulog("login failed for user $u from $ip");
                return respond($c, 401, 'text/html; charset=utf-8', login_page('Wrong user name, password or code.'));
            }
            my $s = $auth->create_session($form{user}) or return respond($c, 500, 'text/plain', "session error\n");
            ulog("login ok for user $u from $ip");
            return redirect($c, '/', set_cookie($s->{token}, $https, 0));
        }
        return redirect($c, '/') if $sess;
        return respond($c, 200, 'text/html; charset=utf-8', login_page(''));
    }
    if ($path eq '/logout') {
        if ($sess && $method eq 'POST' && $same_origin && ct_csrf($sess, $form{_csrf})) {
            $auth->destroy_session($token);
            ulog("logout user $sess->{user} from $ip");
        }
        return redirect($c, '/login', set_cookie('', $https, 1));
    }

    # --- everything else needs a session ---
    return redirect($c, '/login') unless $sess;

    if ($method eq 'POST') {
        unless ($same_origin && ct_csrf($sess, $form{_csrf})) {
            ulog("CSRF check failed for user $sess->{user} from $ip");
            return respond($c, 403, 'text/plain', "request refused (CSRF check)\n");
        }
    } elsif (defined $form{action} && $form{action} ne 'update-progress') {
        return respond($c, 403, 'text/plain', "actions must be submitted with POST\n");
    }

    # --- run the firewall UI ---
    my $out = run_cgi($method, $query, $body, $h{'content-type'}, $sess->{user});
    my ($head, $page) = split /\r?\n\r?\n/, $out, 2;
    $page //= '';
    my ($ctype) = ($head // '') =~ /^Content-type:\s*(.+?)\s*$/mi;
    $ctype ||= 'text/html; charset=utf-8';
    my ($status) = ($head // '') =~ /^Status:\s*(\d{3})/mi;
    if ($ctype =~ m{text/html}) { $page = decorate($page, $sess) }
    return respond($c, $status || 200, $ctype, $page);
}

sub ct_csrf { my ($sess, $v) = @_; return CSF2::UIAuth::ct_eq($sess->{csrf}, $v // '') }

# same_origin(\%headers) -> 1 if the request came from this site's own pages.
# Browsers send Sec-Fetch-Site / Origin on POST; Referer is the fallback.
sub same_origin {
    my ($h) = @_;
    my $sfs = $h->{'sec-fetch-site'};
    return ($sfs eq 'same-origin' || $sfs eq 'none') ? 1 : 0 if defined $sfs;
    my $host = lc($h->{'x-forwarded-host'} // $h->{host} // '');
    for my $src ($h->{origin}, $h->{referer}) {
        next unless defined $src && $src ne 'null';
        my ($oh) = $src =~ m{^https?://([^/]+)}i;
        return (defined $oh && lc $oh eq $host) ? 1 : 0;
    }
    return 0;
}

sub run_cgi {
    my ($method, $query, $body, $ctype, $user) = @_;
    local %ENV = (
        PATH => '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
        REQUEST_METHOD => $method, QUERY_STRING => $query,
        CONTENT_LENGTH => length($body), CONTENT_TYPE => ($ctype // 'application/x-www-form-urlencoded'),
        CSF2_STANDALONE => 1, CSF2_UI_USER => $user,
        CSF2_ETC => $etc, CSF2_VAR => $var, LANG => 'C.UTF-8',
        map { defined $ENV{$_} ? ($_ => $ENV{$_}) : () } qw(CSF2_DRYRUN CSF2_NFT),
    );
    my ($rd, $wr);
    pipe($rd, $wr) or return "Content-type: text/plain\r\n\r\npipe failed\n";
    my $pid = open(my $cgi, '-|');
    if (!defined $pid) { return "Content-type: text/plain\r\n\r\nfork failed\n" }
    if (!$pid) {
        close $wr; open(STDIN, '<&', $rd); open(STDERR, '>', '/dev/null');
        exec($^X, $CGI) or exit 1;
    }
    close $rd; binmode $wr; print {$wr} $body; close $wr;
    local $/; my $out = <$cgi> // ''; close $cgi;
    return $out;
}

# decorate($html, $session) - add the CSRF token to every POST form and a small
# signed-in bar with Log out.
sub decorate {
    my ($html, $s) = @_;
    my $tok = esc($s->{csrf});
    $html =~ s{(<form\b[^>]*\bmethod\s*=\s*["']?post["']?[^>]*>)}{$1<input type="hidden" name="_csrf" value="$tok">}gi;
    my $bar = qq{<div style="display:flex;justify-content:flex-end;align-items:center;gap:12px;padding:6px 16px;background:#1e2433;color:#cfd6e4;font:13px system-ui,sans-serif">}
            . qq{<span>Signed in as <b style="color:#fff">} . esc($s->{user}) . qq{</b></span>}
            . qq{<form method="post" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="$tok">}
            . qq{<button type="submit" style="background:#3b4458;color:#fff;border:0;border-radius:6px;padding:4px 10px;cursor:pointer">Log out</button></form></div>};
    $html =~ s{(<body\b[^>]*>)}{$1$bar}i or $html = $bar . $html;
    return $html;
}

