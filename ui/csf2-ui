    my ($msg) = @_;
    my $err = $msg ? '<p style="color:#b42318;background:#fef3f2;border-radius:8px;padding:8px 10px;margin:0 0 12px">' . esc($msg) . '</p>' : '';
    return <<"HTML";
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CSF Firewall - Sign in</title>
<style>
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#eef1f6;font:15px system-ui,-apple-system,Segoe UI,sans-serif;color:#1e2433}
.card{background:#fff;border-radius:14px;box-shadow:0 8px 30px rgba(20,30,60,.12);padding:28px;width:100%;max-width:340px;margin:16px}
img{height:42px;display:block;margin:0 0 18px}
label{display:block;font-size:13px;color:#5b6475;margin:10px 0 4px}
input{width:100%;box-sizing:border-box;padding:10px 12px;border:1px solid #cfd6e4;border-radius:8px;font-size:15px}
input:focus{outline:2px solid #4f6bed;border-color:#4f6bed}
button{width:100%;margin-top:18px;padding:11px;border:0;border-radius:8px;background:#4f6bed;color:#fff;font-size:15px;font-weight:600;cursor:pointer}
p.hint{font-size:12px;color:#8a93a5;margin:14px 0 0}
</style></head><body><form class="card" method="post" action="/login" autocomplete="off">
<img src="/assets/logo.png" alt="CSF - Core Shield Firewall">
$err
<label for="u">User name</label><input id="u" name="user" required autofocus>
<label for="p">Password</label><input id="p" name="pass" type="password" required>
<label for="c">Authenticator code</label><input id="c" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required>
<button type="submit">Sign in</button>
<p class="hint">Users are managed on the server with <code>csf --ui-user</code>.</p>
</form></body></html>
HTML
}

sub set_cookie {
    my ($val, $secure, $expire) = @_;
    my $c = "csf2ui=$val; Path=/; HttpOnly; SameSite=Strict";
    $c .= '; Secure' if $secure;
    $c .= '; Max-Age=0' if $expire;
    return { 'Set-Cookie' => $c };
}

sub redirect {
    my ($c, $loc, $extra) = @_;
    return respond($c, 303, 'text/plain', "see $loc\n", { Location => $loc, %{ $extra || {} } });
}

my %REASON = (200=>'OK',303=>'See Other',400=>'Bad Request',401=>'Unauthorized',403=>'Forbidden',404=>'Not Found',
              411=>'Length Required',413=>'Payload Too Large',429=>'Too Many Requests',431=>'Request Header Fields Too Large',500=>'Internal Server Error');
sub respond {
    my ($c, $code, $type, $body, $extra) = @_;
    my %hd = (
        'Content-Type' => $type,
        'Content-Length' => length($body),
        'Cache-Control' => 'no-store',
        'X-Frame-Options' => 'DENY',
        'X-Content-Type-Options' => 'nosniff',
        'Referrer-Policy' => 'same-origin',
        'Content-Security-Policy' => "frame-ancestors 'none'; form-action 'self'; base-uri 'none'",
        'Connection' => 'close',
        %{ $extra || {} },
    );
    print {$c} "HTTP/1.1 $code " . ($REASON{$code} || 'OK') . "\r\n";
    print {$c} "$_: $hd{$_}\r\n" for sort keys %hd;
    print {$c} "\r\n", $body;
    return;
}

sub parse_qs {
    my ($data) = @_;
    my %p;
    for my $pair (split /&/, ($data // '')) {
        my ($k, $v) = split /=/, $pair, 2; next unless defined $k;
        for ($k, $v) { $_ //= ''; s/\+/ /g; s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge; }
        $p{$k} = $v;
    }
    return %p;
}

sub esc { my $s = shift // ''; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; $s =~ s/"/&quot;/g; return $s }
